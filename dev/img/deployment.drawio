<mxfile host="app.diagrams.net"><diagram name="A deployment" id="d1"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A DEPLOYMENT IS THE IMAGES BETWEEN TWO CONSECUTIVE VISITS" style="text;html=1;fontSize=15;fontColor=#2563eb;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="800" height="28" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;One location — some GPS coordinates and a timezone — one camera&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="840" height="34" as="geometry"/></mxCell><mxCell id="n4" value="THE VISIT THAT LEFT THE CAMERA" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="300" height="28" as="geometry"/></mxCell><mxCell id="n5" value="THE NEXT VISIT" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=right;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="580" y="108" width="300" height="28" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Visit R0001&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b45309"&gt;left the camera&lt;br&gt;and its card&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontColor=#92400e;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="170" height="104" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Deployment R0001-DONA_01&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1e40af"&gt;the images taken by the camera between the two visits,&lt;br&gt;set up with the same height, tilt, delay between triggers…&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="128" width="460" height="120" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;Visit R0002&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#047857"&gt;collected&lt;br&gt;the card&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;fontColor=#065f46;fontSize=17;" vertex="1" parent="1"><mxGeometry x="710" y="136" width="170" height="104" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="ITS STATE" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="200" height="28" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;Open&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b45309"&gt;the camera is still out: the&lt;br&gt;card has not been collected&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontColor=#92400e;fontSize=15;dashed=1;dashPattern=6 5;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="270" height="76" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;Closed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#047857"&gt;the card is collected: its&lt;br&gt;images can be imported&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;fontColor=#065f46;fontSize=15;" vertex="1" parent="1"><mxGeometry x="325" y="296" width="270" height="76" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;Camera stolen&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b91c1c"&gt;the deployment is closed&lt;br&gt;and has no images&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontColor=#991b1b;fontSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="296" width="270" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>