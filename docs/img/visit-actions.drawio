<mxfile host="app.diagrams.net"><diagram name="The actions of a visit" id="d1"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="THE ACTIONS OF A VISIT" style="text;html=1;fontSize=15;fontColor=#2563eb;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="400" height="28" as="geometry"/></mxCell><mxCell id="n3" value="WHEN IT IS REGISTERED" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="220" height="28" as="geometry"/></mxCell><mxCell id="n4" value="ITS STATE" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="370" y="70" width="220" height="28" as="geometry"/></mxCell><mxCell id="n5" value="WHEN THE NEXT VISIT…" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="730" y="70" width="220" height="28" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Planned&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#475569"&gt;or Unknown&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontSize=17;dashed=1;dashPattern=6 5;" vertex="1" parent="1"><mxGeometry x="30" y="172" width="160" height="76" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Deployed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b45309"&gt;a camera is out&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontColor=#92400e;fontSize=17;" vertex="1" parent="1"><mxGeometry x="370" y="104" width="170" height="76" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;Not visited&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#475569"&gt;it could not be made&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;fontSize=17;" vertex="1" parent="1"><mxGeometry x="370" y="268" width="170" height="76" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Collected&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#047857"&gt;its card was collected&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;fontColor=#065f46;fontSize=17;" vertex="1" parent="1"><mxGeometry x="730" y="104" width="160" height="76" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Stolen&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b91c1c"&gt;no images to import&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontColor=#991b1b;fontSize=17;" vertex="1" parent="1"><mxGeometry x="730" y="196" width="160" height="76" as="geometry"/></mxCell><mxCell id="n11" value="Installation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="198"/><mxPoint x="280" y="142"/></Array></mxGeometry></mxCell><mxCell id="n12" value="no action: not revised" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="222"/><mxPoint x="280" y="306"/></Array></mxGeometry></mxCell><mxCell id="n13" value="does a Revision&lt;br&gt;or a Desinstallation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="does a Stolen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="165"/><mxPoint x="615" y="234"/></Array></mxGeometry></mxCell><mxCell id="n15" value="An Archive goes with a Desinstallation or a Stolen visit: it gives the site up." style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="700" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>