<mxfile host="app.diagrams.net"><diagram name="The life of a research project" id="d1"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="346" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="THE LIFE OF A RESEARCH PROJECT" style="text;html=1;fontSize=15;fontColor=#2563eb;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="800" height="28" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b&gt;Planned&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b45309"&gt;being prepared:&lt;br&gt;no visits yet&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontColor=#92400e;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="140" height="90" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;Active&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#047857"&gt;the study&lt;br&gt;is running&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;fontColor=#065f46;fontSize=17;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="140" height="90" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;Finished&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;the fieldwork&lt;br&gt;is over&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=17;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="140" height="90" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Archived&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#475569"&gt;out of use&lt;br&gt;for good&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;fontSize=17;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="140" height="90" as="geometry"/></mxCell><mxCell id="n7" value="by settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n8" value="by settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="by settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="by settings, from any state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100.0" y="90"/><mxPoint x="820.0" y="90"/></Array></mxGeometry></mxCell><mxCell id="n11" value="reopen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=0.36;exitY=1;exitDx=0;exitDy=0;entryX=0.64;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560.0" y="234"/><mxPoint x="360.0" y="234"/></Array></mxGeometry></mxCell><mxCell id="n12" value="only with no visits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=0.36;exitY=1;exitDx=0;exitDy=0;entryX=0.64;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320.0" y="234"/><mxPoint x="120.0" y="234"/></Array></mxGeometry></mxCell><mxCell id="n13" value="Only a project with no visits goes back to planned. A finished project is not offered when a deployment is" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="268" width="860" height="24" as="geometry"/></mxCell><mxCell id="n14" value="imported, but can be reopened. Archived is final: nothing in it can be changed, and it never goes back." style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="286" width="860" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>