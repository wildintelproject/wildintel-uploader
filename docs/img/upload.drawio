<mxfile host="app.diagrams.net"><diagram name="The life of a deployment, in an upload" id="d1"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="346" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="THE LIFE OF A DEPLOYMENT, IN AN UPLOAD" style="text;html=1;fontSize=15;fontColor=#2563eb;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="800" height="28" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b&gt;Not uploaded&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b45309"&gt;created here, not yet&lt;br&gt;in the portal&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontColor=#92400e;fontSize=17;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="140" height="90" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;Uploaded&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#047857"&gt;in the portal:&lt;br&gt;the day is kept&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;fontColor=#065f46;fontSize=17;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="140" height="90" as="geometry"/></mxCell><mxCell id="n5" value="an upload ends well" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n6" value="It is said for each portal: a deployment can be uploaded to one and not to another. A rehearse, only preparing the" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="268" width="860" height="24" as="geometry"/></mxCell><mxCell id="n7" value="files, or an upload that fails leave it as it was." style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="286" width="860" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>