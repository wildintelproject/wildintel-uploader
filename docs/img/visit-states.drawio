<mxfile host="app.diagrams.net"><diagram name="The states of a visit" id="d1"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="THE STATES OF A VISIT" style="text;html=1;fontSize=15;fontColor=#2563eb;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="400" height="28" as="geometry"/></mxCell><mxCell id="n3" value="BEFORE IT IS REGISTERED" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="200" height="28" as="geometry"/></mxCell><mxCell id="n4" value="WHAT THE VISIT DID" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="200" height="28" as="geometry"/></mxCell><mxCell id="n5" value="WHEN A LATER VISIT…" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="200" height="28" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Planned&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#475569"&gt;not made yet&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontSize=17;dashed=1;dashPattern=6 5;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="170" height="76" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Unknown&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#6d28d9"&gt;nothing is known of it&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#a78bfa;strokeWidth=2;fontColor=#5b21b6;fontSize=17;dashed=1;dashPattern=6 5;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="170" height="76" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;The visit is&lt;br&gt;registered&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="262" y="210" width="150" height="68" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Deployed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b45309"&gt;a camera is out&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontColor=#92400e;fontSize=17;" vertex="1" parent="1"><mxGeometry x="470" y="104" width="170" height="76" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;No state&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#64748b"&gt;left no camera: Desinstallation, Stolen or Archive&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#475569;fontSize=14;dashed=1;dashPattern=3 5;" vertex="1" parent="1"><mxGeometry x="470" y="214" width="170" height="68" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Not visited&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#475569"&gt;it could not be made&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;fontSize=17;" vertex="1" parent="1"><mxGeometry x="470" y="316" width="170" height="76" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;Collected&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#047857"&gt;its card was collected&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;fontColor=#065f46;fontSize=17;" vertex="1" parent="1"><mxGeometry x="720" y="104" width="170" height="76" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;Stolen&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b91c1c"&gt;no images to import&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontColor=#991b1b;fontSize=17;" vertex="1" parent="1"><mxGeometry x="720" y="222" width="170" height="76" as="geometry"/></mxCell><mxCell id="n14" value="it is made" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="222"/><mxPoint x="262" y="222"/></Array></mxGeometry></mxCell><mxCell id="n15" value="it is filled in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="266"/><mxPoint x="262" y="266"/></Array></mxGeometry></mxCell><mxCell id="n16" value="left a camera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="224"/><mxPoint x="455" y="142"/></Array></mxGeometry></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffff