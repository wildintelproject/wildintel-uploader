<mxfile host="app.diagrams.net"><diagram name="The life of an SD card" id="d1"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="416" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="THE LIFE OF AN SD CARD" style="text;html=1;fontSize=15;fontColor=#2563eb;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="800" height="28" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b&gt;A camera&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#475569"&gt;at a site&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="64" width="260" height="76" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;An SD card&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#475569"&gt;its label, its brand, its capacity&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontSize=15;" vertex="1" parent="1"><mxGeometry x="630" y="64" width="260" height="76" as="geometry"/></mxCell><mxCell id="n5" value="holds one card,&lt;br&gt;until it is collected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n6" value="ITS STATES" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="146" width="300" height="24" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Planned&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#b45309"&gt;only in Settings:&lt;br&gt;not in the app&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontColor=#92400e;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="196" width="140" height="90" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;Ready&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;free: in no&lt;br&gt;camera&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=17;" vertex="1" parent="1"><mxGeometry x="270" y="196" width="140" height="90" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Active&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#047857"&gt;in a camera&lt;br&gt;in the field&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;fontColor=#065f46;fontSize=17;" vertex="1" parent="1"><mxGeometry x="510" y="196" width="140" height="90" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Archived&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#475569"&gt;lost, stolen&lt;br&gt;or broken&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;fontSize=17;" vertex="1" parent="1"><mxGeometry x="750" y="196" width="140" height="90" as="geometry"/></mxCell><mxCell id="n11" value="by settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="left in a camera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="stolen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="by settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100.0" y="178"/><mxPoint x="820.0" y="178"/></Array></mxGeometry></mxCell><mxCell id="n15" value="collected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2.5;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580.0" y="330"/><mxPoint x="340.0" y="330"/></Array></mxGeometry></mxCell><mxCell id="n16" value="A card is left by an Installation or a Revision and collected by the next Revision or Desinstallation. Stolen with" style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="860" height="24" as="geometry"/></mxCell><mxCell id="n17" value="its camera, or lost or broken, it is archived for good." style="text;html=1;fontSize=12;fontColor=#64748b;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="30" y="378" width="860" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>